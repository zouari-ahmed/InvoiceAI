  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=invoiceai;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "Jwt": {
    "Key": "REPLACE-WITH-AT-LEAST-32-RANDOM-CHARACTERS",
